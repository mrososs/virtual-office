# --- Server -----------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Demo mode (local development only) ----------------------------------
# Enables POST /api/demo/session, which issues tokens for demo identities
# WITHOUT credentials. Ignored when NODE_ENV=production.
DEMO_MODE=true

# --- Auth ---------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Supabase / Postgres --------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# --- Azure DevOps ---------------------------------------------------------
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=replace-with-personal-access-token
AZURE_DEVOPS_WEBHOOK_SECRET=replace-with-webhook-shared-secret

# --- Microsoft Graph (Teams / Microsoft 365 Calendar) ----------------------
MICROSOFT_TENANT_ID=replace-with-tenant-id
MICROSOFT_CLIENT_ID=replace-with-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback
