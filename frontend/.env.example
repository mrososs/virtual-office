# Copy to .env.local to override locally. See src/core/config/env.ts for how these are read.
# Only public, non-secret configuration belongs here: everything VITE_* ends up in the browser bundle.
# Microsoft sign-in, tokens and client secrets live exclusively in the backend.

# Same-origin by default: the SPA calls /api and connects Socket.IO to its own origin
# (the Vite dev/preview proxy, or the production reverse proxy, forwards them to NestJS).
VITE_API_BASE_URL=/api
# Empty = same origin as the app. Set it when the Socket.IO host is another site than the
# SPA (e.g. SPA on Vercel, API on Railway): the socket then authenticates with a single-use
# ticket from POST /api/auth/realtime-ticket instead of the cookie. See docs/DEPLOYMENT.md.
VITE_SOCKET_URL=

# Demo mode: seeds a demo company, signs you in as a demo identity (no credentials),
# and shows the demo control panel. Never set this for production builds.
VITE_DEMO_MODE=false

# Dev/preview proxy target (read by vite.config.ts, not shipped to the browser).
# VITE_DEV_BACKEND_URL=http://localhost:3001
