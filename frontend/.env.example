# Copy to .env.local to override locally. See src/core/config/env.ts for how these are read.
VITE_API_BASE_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
VITE_AZURE_DEVOPS_REDIRECT_URI=http://localhost:5173/integrations/azure-devops/callback
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/integrations/microsoft/callback

# Demo mode: seeds a demo company, signs you in as a demo identity (no credentials),
# and shows the demo control panel. Never set this for production builds.
VITE_DEMO_MODE=false
