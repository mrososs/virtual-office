# iSaned Virtual Office — backend environment. Copy to backend/.env (gitignored).
# NEVER commit real values. Production refuses to start without the values marked (required in production).

# --- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Public URL of the web app. The API only accepts browser requests from this origin,
# and sign-in redirects back here. In development the Vite dev server proxies /api
# and /socket.io to this backend, so both share http://localhost:5173.
APP_URL=http://localhost:5173
# Reverse proxies in front of the API in production (default 1). Vercel rewriting /api to
# Railway = 2, so per-IP sign-in rate limits see the visitor, not Vercel. See docs/DEPLOYMENT.md.
# TRUST_PROXY_HOPS=1
ORGANIZATION_NAME=iSaned

# --- Sign-in mode ------------------------------------------------------------
# azure_pat        (current) work email + Azure DevOps Personal Access Token, verified against
#                  Azure DevOps — no Microsoft app registration needed. See docs/AZURE_PAT_AUTH.md.
# microsoft_entra  (future) Microsoft Entra SSO — needs an IT-approved app registration (ENTRA_* below).
# demo             demo identities only (local development, never production).
AUTH_PROVIDER=azure_pat

# --- Demo mode (local development only) --------------------------------------
# true: seeded demo company + credential-less demo identities (POST /api/demo/session).
# Ignored when NODE_ENV=production. Demo tokens are rejected by any backend without it.
DEMO_MODE=false
# Signs demo realtime tokens only (production sessions never use JWTs). Optional.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Sessions (required in production) -----------------------------------------
# >= 32 random chars. Keys the session-token hash and seals the sign-in state cookie.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# 32 random bytes, base64. Encrypts stored Azure DevOps PATs (and future Microsoft token caches) at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Sliding idle timeout and absolute lifetime of a session.
SESSION_IDLE_TIMEOUT_HOURS=336
SESSION_ABSOLUTE_TIMEOUT_DAYS=30

# --- Supabase / Postgres (required in production) --------------------------------
# Backend only. The service role key must never reach the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Microsoft Entra ID (OPTIONAL — only for AUTH_PROVIDER=microsoft_entra) --------------
# Inactive until iSaned IT approves an app registration — see docs/MICROSOFT_AUTH_SETUP.md.
# Single-tenant app registration in the iSaned tenant.
# ENTRA_TENANT_ID must be the tenant GUID (never common / organizations / consumers).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Must exactly match a "Web" redirect URI on the app registration.
ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/microsoft/callback
# Only for national clouds (e.g. https://login.microsoftonline.us). Leave unset otherwise.
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com

# --- Azure DevOps (read-only) — see docs/AZURE_DEVOPS_SETUP.md -----------------------------
# AZURE_DEVOPS_ORGANIZATION is required for AUTH_PROVIDER=azure_pat (PATs are verified against it).
# Organization name as in https://dev.azure.com/<organization>
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PROJECT=
# Optional: team inside the project (default: the project's default team).
AZURE_DEVOPS_TEAM=
# Scheduled sync interval, seconds (min 60).
AZURE_DEVOPS_SYNC_INTERVAL_SECONDS=120
# Future Service Hooks (push). Leave empty to keep /api/webhooks/azure-devops disabled.
AZURE_DEVOPS_WEBHOOK_SECRET=
